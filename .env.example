# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/feed
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/profile-setup

# Convex
CONVEX_DEPLOYMENT=dev:your-project
NEXT_PUBLIC_CONVEX_URL=https://your-project.convex.cloud

# Clerk JWT for Convex
NEXT_PUBLIC_CLERK_FRONTEND_API_URL=https://your-issuer.clerk.accounts.dev
CLERK_JWT_ISSUER_DOMAIN=https://your-issuer.clerk.accounts.dev

# Google Gemini API
GOOGLE_GENERATIVE_AI_API_KEY=

# ─────────────────────────────────────────────────────────────────────
# Double Posting (auto-cross-post) — social OAuth credentials
# ─────────────────────────────────────────────────────────────────────
# Each platform's connect button no-ops (returns 501) until both the
# CLIENT_ID and CLIENT_SECRET for that provider are set. Redirect URI
# to register with each app: {SITE_URL}/api/social/{provider}/callback
#
# Canonical URL used as the "read more" link in every auto-post.
NEXT_PUBLIC_SITE_URL=https://uhtech.in

# LinkedIn — https://www.linkedin.com/developers/apps
#   Scopes: openid profile email w_member_social
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# X (Twitter) — https://developer.x.com/en/portal/dashboard
#   OAuth 2.0 with PKCE. Scopes: tweet.read tweet.write users.read offline.access
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# Facebook — https://developers.facebook.com/apps
#   Personal-profile posting is heavily restricted; expect Page-only.
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Instagram — https://developers.facebook.com/apps (IG Basic Display)
#   Text-only publishing NOT supported; only Business/Creator accounts
#   with an image. Auto-post silently skips IG in the meantime.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
